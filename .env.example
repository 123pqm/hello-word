APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
# Copy this file to .env and replace CHANGE_ME locally. Never commit .env.
MYSQL_PASSWORD='CHANGE_ME'
MYSQL_DATABASE=movie_vocab

# Generate locally: .\.venv\Scripts\python.exe -c "import secrets; print(secrets.token_hex(32))"
# Keep this signing key private and stable across server restarts.
JWT_SECRET_KEY=
