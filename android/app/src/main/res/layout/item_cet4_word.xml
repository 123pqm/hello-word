<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/vh_card"
    android:orientation="vertical"
    android:padding="20dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical">
    <TextView
        android:id="@+id/wordEnglish"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:textColor="#1F2329"
        android:textSize="22sp"
        android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatCheckBox
            android:id="@+id/wordSelected"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:button="@null"
            android:buttonTint="@null"
            android:padding="0dp"
            app:buttonCompat="@drawable/cet4_word_checkbox"
            app:buttonTint="@null"
            android:focusable="false" />
    </LinearLayout>
    <TextView
        android:id="@+id/wordPos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="#3478F6"
        android:textSize="14sp" />
    <TextView
        android:id="@+id/wordMeaning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#475467"
        android:textSize="16sp" />
</LinearLayout>
