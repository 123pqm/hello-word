<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
    android:orientation="vertical" android:gravity="center">
    <TextView android:id="@+id/checkinWeekday" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="#737B87" android:textSize="12sp" />
    <TextView android:id="@+id/checkinDate" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="5dp" android:text="—" android:textColor="#929AA7" android:textSize="10sp" />
    <ImageView android:id="@+id/checkinMark" android:layout_width="24dp" android:layout_height="24dp"
        android:layout_marginTop="8dp" android:src="@drawable/vh_unchecked" android:importantForAccessibility="yes" />
</LinearLayout>
