<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="104dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="16dp"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <FrameLayout
        android:id="@+id/myBookCover"
        android:layout_width="50dp"
        android:layout_height="66dp"
        android:importantForAccessibility="noHideDescendants">

        <View
            android:layout_width="3dp"
            android:layout_height="50dp"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="4dp"
            android:background="#30FFFFFF" />

        <TextView
            android:id="@+id/myBookCoverLabel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingBottom="5dp"
            android:gravity="center"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <View
            android:layout_width="38dp"
            android:layout_height="3dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="5dp"
            android:background="#CFFFFFFF" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/myBookName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#252B35"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/myBookDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#818894"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/myBookStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:textColor="#8B929D"
            android:textSize="11sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/myBookSelected"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:importantForAccessibility="no" />
</LinearLayout>
