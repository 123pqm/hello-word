<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/vh_background" android:fillViewport="true" android:clipToPadding="false" android:overScrollMode="never" android:scrollbars="none">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="18dp" android:paddingBottom="24dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="18dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView style="@style/VhText" android:textSize="26sp" android:textStyle="bold" android:accessibilityHeading="true" android:text="@string/vh_greeting" />
                <TextView style="@style/VhSecondary" android:textSize="14sp" android:layout_marginTop="6dp" android:text="@string/vh_subtitle" />
            </LinearLayout>
            <ImageView android:layout_width="68dp" android:layout_height="68dp" android:src="@drawable/vh_robot" android:importantForAccessibility="no" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="140dp" android:id="@+id/homeNewTask" android:background="@drawable/vh_task_background" android:elevation="3dp" android:orientation="horizontal" android:gravity="center_vertical" android:padding="20dp">
            <ImageView android:layout_width="54dp" android:layout_height="54dp" android:src="@drawable/vh_plus" android:importantForAccessibility="no" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="16dp" android:orientation="vertical">
                <TextView style="@style/VhText" android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold" android:text="@string/vh_new_task" />
                <TextView style="@style/VhText" android:textColor="#DAE6FF" android:textSize="13sp" android:layout_marginTop="6dp" android:text="@string/vh_new_task_hint" />
            </LinearLayout>
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/vh_chevron" android:importantForAccessibility="no" android:layout_marginStart="4dp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="22dp" android:layout_marginBottom="10dp">
            <TextView style="@style/VhSection" android:layout_width="0dp" android:layout_weight="1" android:accessibilityHeading="true" android:text="@string/vh_recent" />
            <LinearLayout android:layout_width="wrap_content" android:layout_height="48dp" android:id="@+id/homeMore" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="12dp">
                <TextView style="@style/VhSecondary" android:textSize="12sp" android:text="@string/vh_more" />
                <ImageView android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/vh_more" android:importantForAccessibility="no" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/homeRecentLesson" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/vh_card" android:padding="6dp">
            <FrameLayout android:layout_width="100dp" android:layout_height="132dp" android:background="@drawable/vh_poster_background" android:clipToOutline="true">
                <ImageView android:id="@+id/homeRecentCover" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@android:drawable/ic_menu_gallery" android:scaleType="centerCrop" android:importantForAccessibility="no" />
            </FrameLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="14dp" android:paddingEnd="9dp" android:paddingTop="8dp" android:paddingBottom="8dp">
                <TextView android:id="@+id/homeRecentTitle" style="@style/VhText" android:textSize="18sp" android:textStyle="bold" android:maxLines="2" android:ellipsize="end" android:text="暂无最近学习" />
                <TextView android:id="@+id/homeRecentDetails" style="@style/VhSecondary" android:layout_marginTop="12dp" android:text="选择视频后，这里会显示电影信息" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="20dp">
                    <ProgressBar android:layout_width="0dp" android:layout_height="6dp" style="@android:style/Widget.ProgressBar.Horizontal" android:layout_weight="1" android:id="@+id/homeLessonProgress" android:max="100" android:progress="0" android:visibility="gone" android:indeterminate="false" android:progressDrawable="@drawable/vh_progress" android:progressTint="@color/vh_blue" android:progressBackgroundTint="#E8EAF0" android:importantForAccessibility="no" />
                    <TextView style="@style/VhSecondary" android:id="@+id/homeLessonProgressLabel" android:textSize="11sp" android:layout_marginStart="10dp" android:text="" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <TextView style="@style/VhSection" android:layout_marginTop="22dp" android:layout_marginBottom="12dp" android:accessibilityHeading="true" android:text="@string/vh_today" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="false">
            <LinearLayout android:layout_width="0dp" android:layout_height="88dp" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:background="@drawable/vh_card" android:layout_marginStart="0dp" android:padding="8dp">
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/vh_book" android:importantForAccessibility="no" />
                    <TextView style="@style/VhNumber" android:id="@+id/homeWordsCount" android:layout_marginStart="7dp" android:text="@string/vh_32" />
                </LinearLayout>
                <TextView style="@style/VhText" android:textSize="13sp" android:textColor="#646B76" android:layout_marginTop="10dp" android:text="@string/vh_words" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="88dp" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:background="@drawable/vh_card" android:layout_marginStart="8dp" android:padding="8dp">
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/vh_clock" android:importantForAccessibility="no" />
                    <TextView style="@style/VhNumber" android:id="@+id/homeStudyMinutes" android:layout_marginStart="7dp" android:text="@string/vh_18" />
                    <TextView style="@style/VhSecondary" android:textSize="10sp" android:layout_marginStart="3dp" android:layout_gravity="bottom" android:layout_marginBottom="2dp" android:text="@string/vh_min" />
                </LinearLayout>
                <TextView style="@style/VhText" android:textSize="13sp" android:textColor="#646B76" android:layout_marginTop="10dp" android:text="@string/vh_duration" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="88dp" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:background="@drawable/vh_card" android:layout_marginStart="8dp" android:padding="8dp">
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/vh_mastery" android:importantForAccessibility="no" />
                    <TextView style="@style/VhNumber" android:id="@+id/homeMasteredCount" android:layout_marginStart="7dp" android:text="@string/vh_24" />
                </LinearLayout>
                <TextView style="@style/VhText" android:textSize="13sp" android:textColor="#646B76" android:layout_marginTop="10dp" android:text="@string/vh_mastered" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/vh_card" android:orientation="vertical" android:padding="14dp" android:layout_marginTop="12dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <TextView style="@style/VhText" android:textSize="16sp" android:textStyle="bold" android:layout_width="0dp" android:layout_weight="1" android:accessibilityHeading="true" android:text="@string/vh_checkin" />
                <TextView style="@style/VhSecondary" android:textSize="12sp" android:text="@string/vh_streak" />
                <TextView style="@style/VhNumber" android:id="@+id/homeStreakDays" android:layout_marginStart="7dp" android:layout_marginEnd="6dp" android:textSize="23sp" android:text="—" />
                <TextView style="@style/VhSecondary" android:textSize="12sp" android:text="@string/vh_days" />
            </LinearLayout>
            <LinearLayout android:id="@+id/homeCheckinDays" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="18dp" />
            <TextView android:id="@+id/homeCheckinSummary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:gravity="center" android:textSize="12sp" android:textColor="#737B87" android:text="正在同步打卡记录…" android:accessibilityLiveRegion="polite" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
