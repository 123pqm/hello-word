<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/flashcardRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA"
    android:orientation="vertical">

    <ScrollView
        android:id="@+id/flashcardScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="vertical"
        android:fadeScrollbars="false"
        android:scrollbarStyle="insideInset"
        android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- ======================== -->
        <!-- 顶部标题 -->
        <!-- ======================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="18dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="单词闪卡"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#1F2937" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/flashcardAi"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="0dp"
                android:src="@drawable/vh_robot"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="打开 AI 学习助手" />
        </LinearLayout>


        <!-- ======================== -->
        <TextView
            android:id="@+id/tvFlashcardProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:textColor="#6B7280"
            android:textSize="14sp" />

        <!-- 服务器视频播放器 -->
        <!-- ======================== -->


        <!-- ======================== -->
        <!-- 单词卡片 -->
        <!-- ======================== -->
        <com.example.helloword.component.MoviePlayerView
            android:id="@+id/moviePlayer"
            android:layout_width="match_parent"
            android:layout_height="240dp" />

        <TextView android:id="@+id/videoSourceStatus" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="8dp"
            android:textColor="#667085" android:textSize="12sp" android:accessibilityLiveRegion="polite" />
        <Button android:id="@+id/chooseLocalMovie" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="48dp" android:text="重新连接视频"
            android:textColor="#3478F6" android:backgroundTint="#EAF2FF" />

        <LinearLayout
            android:id="@+id/flashcardCard"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_word_card"
            android:clipToOutline="true"
            android:elevation="4dp">
            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/btnFavoriteWord"
                android:layout_width="48dp" android:layout_height="48dp"
                android:layout_gravity="end" android:layout_margin="4dp"
                android:padding="13dp" android:src="@drawable/favorite_star"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="收藏当前单词" android:enabled="false"
                android:accessibilityLiveRegion="polite" />
            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:gravity="center_horizontal"
                android:paddingHorizontal="28dp" android:paddingTop="4dp" android:paddingBottom="28dp">
            <TextView
                android:id="@+id/tvWord"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center" android:textAlignment="center"
                android:text="beautiful" android:textColor="#111827"
                android:textSize="34sp" android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/wordCardRevealArea"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true"
                android:minHeight="48dp">

                <LinearLayout
                    android:id="@+id/wordCardContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <!-- 音标 -->
                    <TextView
                        android:id="@+id/tvPhonetic"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="/ˈbjuːtɪfl/"
                        android:textColor="#6B7280"
                        android:textSize="17sp" />

                    <!-- 词性 -->
                    <TextView
                        android:id="@+id/tvPos"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:text="adj."
                        android:textColor="#3478F6"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <!-- 中文释义 -->
                    <TextView
                        android:id="@+id/tvMeaning"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:text="美丽的；漂亮的；美好的"
                        android:textColor="#374151"
                        android:textSize="20sp" />

                </LinearLayout>

                <TextView
                    android:id="@+id/wordCardMask"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:clickable="false"
                    android:gravity="center"
                    android:importantForAccessibility="no"
                    android:text="点击显示单词释义"
                    android:textColor="#64748B"
                    android:textSize="14sp" />
            </LinearLayout>

            <View
                android:id="@+id/sentenceDivider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="28dp"
                android:background="#E5E7EB" />

            <LinearLayout
                android:id="@+id/sentenceRevealArea"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true"
                android:minHeight="48dp">

                <LinearLayout
                    android:id="@+id/sentenceContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvSentence"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textColor="#1F2937"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/tvSentenceMeaning"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:textColor="#9CA3AF"
                        android:textSize="15sp"
                        android:visibility="gone" />
                </LinearLayout>

                <TextView
                    android:id="@+id/sentenceMask"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:clickable="false"
                    android:gravity="center"
                    android:importantForAccessibility="no"
                    android:text="点击显示例句"
                    android:textColor="#64748B"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvSentenceStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="暂无例句，重新上传并处理视频后可查看"
                android:textColor="#6B7280"
                android:textSize="14sp"
                android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/btnJumpToSentence"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="52dp"
            android:enabled="false"
            android:backgroundTint="#EAF2FF"
            android:text="记不起来，跳转试一下"
            android:textColor="#3478F6"
            android:textSize="16sp" />

        <!-- 切换单词 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnPrevious"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="52dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:enabled="false"
                android:backgroundTint="#FFFFFF"
                android:text="← 上一个单词"
                android:textColor="#3478F6"
                android:textSize="16sp" />

            <Button
                android:id="@+id/btnNext"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="52dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:backgroundTint="#FFFFFF"
                android:text="下一个单词 →"
                android:textColor="#3478F6"
                android:textSize="16sp" />

        </LinearLayout>

    </LinearLayout>

    </ScrollView>

</LinearLayout>
