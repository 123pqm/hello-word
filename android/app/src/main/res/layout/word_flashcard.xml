<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/flashcardRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- ======================== -->
        <!-- 顶部标题 -->
        <!-- ======================== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="单词闪卡"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#1F2937"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="18dp" />


        <!-- ======================== -->
        <TextView
            android:id="@+id/tvFlashcardProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:textColor="#6B7280"
            android:textSize="14sp" />

        <!-- 本地视频播放器 -->
        <!-- ======================== -->


        <!-- ======================== -->
        <!-- 单词卡片 -->
        <!-- ======================== -->
        <com.example.helloword.component.MoviePlayerView
            android:id="@+id/moviePlayer"
            android:layout_width="match_parent"
            android:layout_height="240dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_word_card"
            android:elevation="4dp"
            android:clipToOutline="true"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="28dp">

                <!-- 单词始终清晰显示，不属于下方的模糊和遮罩区域。 -->
                <TextView
                    android:id="@+id/tvWord"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="beautiful"
                    android:textColor="#111827"
                    android:textSize="34sp"
                    android:textStyle="bold" />

            <FrameLayout
                android:id="@+id/wordCardRevealArea"
                android:minHeight="48dp"
                android:clickable="true"
                android:focusable="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:id="@+id/wordCardContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                <!-- 音标 -->
                <TextView
                    android:id="@+id/tvPhonetic"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="/ˈbjuːtɪfl/"
                    android:textColor="#6B7280"
                    android:textSize="17sp" />

                <!-- 词性 -->
                <TextView
                    android:id="@+id/tvPos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="adj."
                    android:textColor="#3478F6"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <!-- 中文释义 -->
                <TextView
                    android:id="@+id/tvMeaning"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="美丽的；漂亮的；美好的"
                    android:textColor="#374151"
                    android:textSize="20sp" />

                <!-- 分割线 -->
                    <View
                        android:id="@+id/sentenceDivider"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="28dp"
                        android:background="#E5E7EB" />

                    <!-- 电影字幕/例句 -->
                <TextView
                    android:id="@+id/tvSentence"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:gravity="center"
                    android:text="It's a beautiful day."
                    android:textColor="#1F2937"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/tvSentenceMeaning"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="今天真是美好的一天。"
                    android:textColor="#9CA3AF"
                    android:textSize="15sp" />

                </LinearLayout>


            <!-- 遮罩覆盖内容，不参与卡片内容的高度计算。 -->
            <View
                android:id="@+id/wordCardMask"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0.98"
                android:background="#F5F7FA"
                android:clickable="false"
                android:importantForAccessibility="no"
                android:visibility="visible" />

            </FrameLayout>

            <TextView
                android:id="@+id/tvSentenceStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="暂无例句，重新上传并处理视频后可查看"
                android:textColor="#6B7280"
                android:textSize="14sp"
                android:visibility="gone" />
        </LinearLayout>

    </LinearLayout>
    </ScrollView>

    <!-- 操作区独立于滚动内容，始终保留在屏幕底部。 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#F5F7FA"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <Button
            android:id="@+id/btnJumpToSentence"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="52dp"
            android:enabled="false"
            android:backgroundTint="#EAF2FF"
            android:text="记不起来，跳转试一下"
            android:textColor="#3478F6"
            android:textSize="16sp" />

        <!-- 切换单词 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnPrevious"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="52dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:enabled="false"
                android:backgroundTint="#FFFFFF"
                android:text="← 上一个单词"
                android:textColor="#3478F6"
                android:textSize="16sp" />

            <Button
                android:id="@+id/btnNext"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="52dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:backgroundTint="#FFFFFF"
                android:text="下一个单词 →"
                android:textColor="#3478F6"
                android:textSize="16sp" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
